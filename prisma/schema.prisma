// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model CourseGroup {
  id          String   @id @default(cuid())
  name        String
  description String?
  icon        String? // emoji icon
  color       String? // accent color
  order       Int      @default(0)
  courses     Course[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([order])
  @@map("course_groups")
}

model Course {
  id          String   @id @default(cuid())
  groupId     String?  @map("group_id")
  group       CourseGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  title       String
  description String?
  icon        String? // emoji icon
  color       String? // accent color (tailwind-ish hex)
  order       Int      @default(0)
  hidden      Boolean  @default(false) // hide from public view
  labs        Lab[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([groupId])
  @@index([hidden, order])
  @@map("courses")
}

model Lab {
  id          String   @id @default(cuid())
  courseId    String   @map("course_id")
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?
  order       Int      @default(0)
  hidden      Boolean  @default(false) // hide from public view
  // Link feature: "none" (default) | "download" | "watch"
  linkType    String   @default("none") @map("link_type")
  linkUrl     String?  @map("link_url")
  modules     Module[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([courseId, hidden, order])
  @@map("labs")
}

model Module {
  id          String   @id @default(cuid())
  labId       String   @map("lab_id")
  lab         Lab      @relation(fields: [labId], references: [id], onDelete: Cascade)
  title       String
  // Part 1: Title & Explanation
  explanation String? // rich text HTML
  // Part 2: Lab Overview & Flow
  overview    String? // rich text HTML
  flow        String? // JSON array of flow nodes [{label, type}]
  // Part 3: Lab Procedure with Steps (stored as related Step rows)
  // Part 4: Output
  output            String? // rich text HTML
  outputCode        String? @map("output_code") // code snippet text (shown below output rich text)
  outputCodeLang    String? @map("output_code_lang") // language for syntax highlighting
  outputImage       String? @map("output_image") // ImageKit CDN URL
  outputImageFileId String? @map("output_image_file_id") // ImageKit fileId for deletion
  outputImageCaption String? @map("output_image_caption")
  order             Int      @default(0)
  hidden      Boolean  @default(false) // hide from public view
  steps       Step[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([labId, hidden, order])
  @@map("modules")
}

model Step {
  id           String   @id @default(cuid())
  moduleId     String   @map("module_id")
  module       Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title        String
  description  String? // rich text HTML
  code         String? // code snippet text
  codeLang     String? @map("code_lang") // language for syntax highlighting
  image        String? // ImageKit CDN URL
  imageFileId  String? @map("image_file_id") // ImageKit fileId for deletion
  imageCaption String? @map("image_caption")
  snippets     String? @map("snippets") // JSON array of CodeSnippet[]
  order        Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([moduleId, order])
  @@map("steps")
}
